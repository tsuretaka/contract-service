{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contract-service-poc-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "contract-service-poc",
    "database_id": "89826250-6f6f-4084-a06b-352eacd2cba4",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "CONTRACTS",
    "bucket_name": "contract-service-poc"
  }],
  "vars": {
    "APP_ORIGIN": "https://contract-service-poc-web.pages.dev",
    "ADMIN_USERNAME": "admin",
    "SIGNING_VALID_DAYS": "7",
    "MAX_PDF_BYTES": "10485760",
    "PDF_FONT_KEY": "system/fonts/ipaexg.ttf"
  }
}
