{
  "name": "contract-service-cloudflare-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy frontend --project-name contract-service-poc-web --branch poc/cloudflare-workers-pages",
    "db:migrate:local": "wrangler d1 migrations apply contract-service-poc --local",
    "db:migrate:remote": "wrangler d1 migrations apply contract-service-poc --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@types/node": "^24.5.2",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "wrangler": "4.133.0"
  }
}
